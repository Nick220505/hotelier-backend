# Variables de entorno para Hotelier Backend

# Configuración de la aplicación
NODE_ENV=development
PORT=3001

# Base de datos PostgreSQL
DATABASE_URL="postgresql://hotelier_user:hotelier_password@localhost:5432/hotelier_db?schema=public"

# JWT Secret (cambiar en producción)
JWT_SECRET="hotelier_jwt_secret_key_2024_change_this_in_production"

# Configuraciones de autenticación
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# URLs del frontend
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Configuraciones de email (opcional)
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM=""

# Configuraciones de uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH="./uploads"

# Redis (opcional)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# Configuraciones de logging
LOG_LEVEL="debug"
LOG_FILE="logs/app.log"